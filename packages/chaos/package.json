{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/rigor-chaos",
  "version": "0.1.4",
  "description": "Open-loop load schedules with planned arrival times from a rate profile, and a measure of latency from the planned time with no coordinated omission.",
  "keywords": [
    "load",
    "open-loop",
    "schedule",
    "poisson",
    "chaos",
    "coordinated-omission",
    "latency",
    "testing",
    "benchmark"
  ],
  "homepage": "https://github.com/mark1russell7/rigor/tree/main/packages/chaos#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/rigor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/rigor.git",
    "directory": "packages/chaos"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/rigor-generators": "workspace:^",
    "@mark1russell7/rigor-statistics": "workspace:^"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
