{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/rigor-generators",
  "version": "0.1.13",
  "description": "A seeded random number generator (mulberry32) with the draws that tests and benchmarks make: integers, picks, weights, shuffles, samples, normal values and named streams. It also gives a content hash: SHA-256 and canonical JSON (RFC 8785).",
  "keywords": [
    "random",
    "seed",
    "seeded",
    "prng",
    "mulberry32",
    "fnv1a",
    "sha256",
    "canonical-json",
    "jcs",
    "deterministic",
    "testing",
    "benchmark",
    "fixtures"
  ],
  "homepage": "https://github.com/mark1russell7/rigor/tree/main/packages/generators#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/rigor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/rigor.git",
    "directory": "packages/generators"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
