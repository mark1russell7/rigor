{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/rigor-bench",
  "version": "0.2.26",
  "description": "The paired-time records of a bench: the order that turns each round, the ratio of each case, and the time verdict against the band of an A/A arm.",
  "keywords": [
    "benchmark",
    "paired",
    "a/a",
    "noise",
    "bootstrap",
    "performance",
    "timing"
  ],
  "homepage": "https://github.com/mark1russell7/rigor/tree/main/packages/bench#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/rigor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/rigor.git",
    "directory": "packages/bench"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fresh": "./src/fresh.ts",
    "./supervise": "./src/supervise.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js"
      },
      "./fresh": {
        "types": "./build/fresh.d.ts",
        "import": "./build/fresh.js"
      },
      "./supervise": {
        "types": "./build/supervise.d.ts",
        "import": "./build/supervise.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/rigor-generators": "workspace:^",
    "@mark1russell7/rigor-statistics": "workspace:^"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
