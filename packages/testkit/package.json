{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/rigor-testkit",
  "version": "0.1.5",
  "description": "Test helpers: the code blocks of Markdown files as test cases, model-based tests on fast-check, the propagation gate of one context id over each transport, the capture of the OpenTelemetry SDK, and a check of an operation that must give a rejected promise.",
  "keywords": [
    "testing",
    "markdown",
    "doctest",
    "examples",
    "documentation",
    "vitest",
    "node-test",
    "model-based",
    "property-based",
    "fast-check",
    "opentelemetry",
    "propagation",
    "baggage"
  ],
  "homepage": "https://github.com/mark1russell7/rigor/tree/main/packages/testkit#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/rigor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/rigor.git",
    "directory": "packages/testkit"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./model": {
        "types": "./build/model.d.ts",
        "import": "./build/model.js",
        "default": "./build/model.js"
      },
      "./propagation": {
        "types": "./build/propagation.d.ts",
        "import": "./build/propagation.js",
        "default": "./build/propagation.js"
      },
      "./otel": {
        "types": "./build/otel.d.ts",
        "import": "./build/otel.js",
        "default": "./build/otel.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts",
    "./propagation": "./src/propagation.ts",
    "./otel": "./src/otel.ts",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.213.0 || ^0.223.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "fast-check": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/api-logs": {
      "optional": true
    },
    "@opentelemetry/sdk-logs": {
      "optional": true
    },
    "@opentelemetry/sdk-metrics": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "fast-check": {
      "optional": true
    }
  }
}
