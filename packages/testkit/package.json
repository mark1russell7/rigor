        "default": "./build/http.js"
      },
      "./otlp": {
        "types": "./build/otlp.d.ts",
        "import": "./build/otlp.js",
        "default": "./build/otlp.js"
      },
      "./fakes": {
        "types": "./build/fakes.d.ts",
        "import": "./build/fakes.js",
        "default": "./build/fakes.js"
      },
      "./child": {
        "types": "./build/child.d.ts",
        "import": "./build/child.js",
        "default": "./build/child.js"
      },
      "./stop": {
        "types": "./build/stop.d.ts",
        "import": "./build/stop.js",
        "default": "./build/stop.js"
      },
      "./stop-point": {
        "types": "./build/stop-point.d.ts",
        "import": "./build/stop-point.js",
        "default": "./build/stop-point.js"
      },
      "./behavior": {
