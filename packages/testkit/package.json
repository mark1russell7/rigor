{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/rigor-testkit",
  "version": "0.2.0",
  "description": "Test helpers: the code blocks of Markdown files as test cases, model-based tests on fast-check, metamorphic relations on fast-check, arbitraries that are uniform by value, the propagation gate of one context id over each transport, the capture of the OpenTelemetry SDK, a scripted HTTP server for fixtures, a scripted XMPP server with test certificates, a stand-in OTLP collector, a fake event target, a server of a test in a child process that reports its port, the harness of a stop plan that stops a process of a test at a step or a time, a behavior check of two functions on the same seeded inputs, and a check of an operation that must give a rejected promise.",
  "keywords": [
    "testing",
    "markdown",
    "doctest",
    "examples",
    "documentation",
    "vitest",
    "node-test",
    "model-based",
    "property-based",
    "fast-check",
    "opentelemetry",
    "propagation",
    "baggage",
    "otlp",
    "fakes",
    "crash",
    "stop-plan",
    "differential-testing",
    "xmpp",
    "tls"
  ],
  "homepage": "https://github.com/mark1russell7/rigor/tree/main/packages/testkit#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/rigor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/rigor.git",
    "directory": "packages/testkit"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./model": {
        "types": "./build/model.d.ts",
        "import": "./build/model.js",
        "default": "./build/model.js"
      },
      "./metamorphic": {
        "types": "./build/metamorphic.d.ts",
        "import": "./build/metamorphic.js",
        "default": "./build/metamorphic.js"
