      "./xmpp": {
        "types": "./build/xmpp.d.ts",
        "import": "./build/xmpp.js",
        "default": "./build/xmpp.js"
      },
      "./tls": {
        "types": "./build/tls.d.ts",
        "import": "./build/tls.js",
        "default": "./build/tls.js"
      },
      "./process-starts": {
        "types": "./build/process-starts.d.ts",
        "import": "./build/process-starts.js",
        "default": "./build/process-starts.js"
      },
      "./git-fixture": {
        "types": "./build/git-fixture.d.ts",
        "import": "./build/git-fixture.js",
        "default": "./build/git-fixture.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
