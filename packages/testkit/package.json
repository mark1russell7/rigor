    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@types/ltx": "^3.1.1",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "ltx": "^3.1.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts",
    "./metamorphic": "./src/metamorphic.ts",
    "./arbitrary": "./src/arbitrary.ts",
    "./propagation": "./src/propagation.ts",
    "./otel": "./src/otel.ts",
    "./http": "./src/http.ts",
    "./otlp": "./src/otlp.ts",
    "./fakes": "./src/fakes.ts",
    "./child": "./src/child.ts",
    "./stop": "./src/stop.ts",
    "./stop-point": "./src/stop-point.ts",
    "./behavior": "./src/behavior.ts",
    "./xmpp": "./src/xmpp.ts",
    "./tls": "./src/tls.ts",
    "./process-starts": "./src/process-starts.ts",
    "./git-fixture": "./src/git-fixture.ts",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@mark1russell7/rigor-chaos": "^0.3.2",
    "@mark1russell7/rigor-generators": "^0.1.18 || ^0.2.0",
    "@mark1russell7/rigor-proxy": "^0.4.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.213.0 || ^0.223.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "fast-check": "^4.0.0",
    "ltx": "^3.1.2"
  },
  "peerDependenciesMeta": {
