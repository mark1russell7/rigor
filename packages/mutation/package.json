{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/rigor-mutation",
  "version": "0.1.0",
  "description": "Mutation tests with Stryker and Vitest for each package of a repository: the Stryker config of each package or part, a score with a gate for each package, and a check of the disabled mutants.",
  "keywords": [
    "mutation",
    "mutation-testing",
    "stryker",
    "vitest",
    "gate",
    "monorepo",
    "testing",
    "ci"
  ],
  "homepage": "https://github.com/mark1russell7/rigor/tree/main/packages/mutation#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/rigor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/rigor.git",
    "directory": "packages/mutation"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "bin": {
    "rigor-mutation": "./src/cli.ts"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js"
      },
      "./package.json": "./package.json"
    },
    "bin": {
      "rigor-mutation": "./build/cli.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "esbuild": "^0.28.2",
    "tsdown": "^0.23.1"
  }
}
