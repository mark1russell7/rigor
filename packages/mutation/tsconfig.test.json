{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "types": [
      "node"
    ],
    "rootDir": "."
  },
  "include": [
    "src/**/*",
    "test/**/*.ts",
    "*.config.ts"
  ],
  "exclude": []
}
